@page "/badgeedit/{id}"
@page "/badgeedit"
@inject IBadgesPageDataService badgesService
@inject NavigationManager Navigation
@rendermode InteractiveServer
<h3>Badge Edit Page</h3>
@if (_badge == null)
{
    <p>Loading...</p>
}
else
{
    <p>Title: <input type="text" @bind="_badge.Title" /></p>
    <p>Description: <input type="text" @bind="_badge.Description" /></p>
    <p>TurnInInstructions: <input type="text" @bind="_badge.TurnInInstructions" /></p>
    <p>IsVisible: <input type="checkbox" @bind="_badge.IsVisible" /></p>

    <p><button type="button" @onclick="OnSubmitAsync">Submit</button><button type="button" @onclick="OnCancel">Cancel</button></p>
    <p>@message</p>
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private string? message;
    private Badge? _badge;

    protected async override Task OnInitializedAsync()
    {
        if (Id is not null)
        {
            _badge = await badgesService.GetBadgeAsync(Guid.Parse(Id));
        }
        else
        {
            _badge = new Badge();
        }
    }
    private async Task OnSubmitAsync(MouseEventArgs e)
    {
        if (_badge is not null)
        {
            await badgesService.UpdateBadge(_badge);
            Navigation.NavigateTo("badges");
        }
        else
        {
            message = "Could not update badge please try again.";
        }
    }
    private void OnCancel(MouseEventArgs e)
    {
        Navigation.NavigateTo("badges");
    }
}
