@page "/badgeedit/{id}"
@inject IBadgesPageDataService badgesService
@rendermode InteractiveServer
<h3>Badge Edit Page</h3>
@if (_badge == null)
{
    <p>Loading...</p>
}
else
{
    <p>Title: <input type="text" @bind="_badge.Title" /></p>
    <p>Description: <input type="text" @bind="_badge.Description" /></p>
    <p>TurnInInstructions: <input type="text" @bind="_badge.TurnInInstructions" /></p>
    <p>IsVisible: <input type="checkbox" @bind="_badge.IsVisible" /></p>
}

<p><a href="badges">return to badges page</a></p>

@code {
    [Parameter]
    public string? Id { get; set; }

    private Badge? _badge;

    protected async override Task OnInitializedAsync()
    {
        if (Id is not null)
        {
            _badge = await badgesService.GetBadgeAsync(Guid.Parse(Id));
        }
        else
        {
            _badge = new Badge();
        }
    }
}
