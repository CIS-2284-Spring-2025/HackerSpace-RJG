@page "/badges"
@rendermode InteractiveServer
@inject NavigationManager Navigation

@inject IBadgesPageDataService badgesService

<h3>Badges Page</h3>
@if(_badges == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col">Published</th>
                <th scope="col">Commands</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var badge in _badges)
        {
            <tr>
                <td>@badge.Title</td>
                <td>@badge.IsVisible</td>
                <td>
                    <button  class="btn btn-sm btn-outline-primary" type="button" @onclick="(()=>SelectBadge(badge))">View</button>   
                    <AuthorizeView Roles="Admin">
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="(()=>EditBadge(badge))">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" type="button" @onclick="(()=>DeleteBadgeAsync(badge))">Delete</button>
                    </AuthorizeView>                        
                </td>
            </tr>
        }
        </tbody>
    </table>
    <AuthorizeView Roles="Admin">
        <button class="btn btn-primary" type="button" @onclick="AddBadge">Add</button>
    </AuthorizeView>
}

@code {
    private List<Badge>? _badges;

    protected override async Task OnInitializedAsync()
    {
        _badges = await badgesService.GetAllAsync();
        await base.OnInitializedAsync();
    }

    protected void SelectBadge(Badge badge)
    {
        Navigation.NavigateTo($"/badge/{badge.Id.ToString()}");
    }

    protected void EditBadge(Badge badge)
    {
        Navigation.NavigateTo($"/badgeedit/{badge.Id.ToString()}");
    }
    private void AddBadge(MouseEventArgs e)
    {
        Navigation.NavigateTo("badgeedit");
    }
    private async Task DeleteBadgeAsync(Badge badge)
    {
        await badgesService.DeleteBadgeAsync(badge.Id);
        _badges?.Remove(badge);
    }
}
