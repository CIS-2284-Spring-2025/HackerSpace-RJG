@page "/badges"
@rendermode InteractiveServer
@inject NavigationManager Navigation

@inject IBadgesPageDataService badgesService
<h3>Badges Page</h3>
@if(_badges == null)
{
    <p>Loading...</p>
}
else
{
    <ul>
        @foreach (var badge in _badges)
        {
            <li>
                <p>@badge.Id</p>
                <p>@badge.Title</p>
                <p>@badge.Description</p>
                <p>@badge.TurnInInstructions</p>
                <p>@badge.IsVisible</p>
                <p>
                    <button type="button" @onclick="(()=>SelectBadge(badge))">View</button>
                    <button type="button" @onclick="(()=>EditBadge(badge))">Edit</button>
                </p>
            </li>
        }
    </ul>
}

@code {
    private List<Badge>? _badges;

    protected override async Task OnInitializedAsync()
    {
        _badges = await badgesService.GetAllAsync();
        await base.OnInitializedAsync();
    }

    protected void SelectBadge(Badge badge)
    {
        Navigation.NavigateTo($"/badge/{badge.Id.ToString()}");
    }

    protected void EditBadge(Badge badge)
    {
        Navigation.NavigateTo($"/badgeedit/{badge.Id.ToString()}");
    }
}
