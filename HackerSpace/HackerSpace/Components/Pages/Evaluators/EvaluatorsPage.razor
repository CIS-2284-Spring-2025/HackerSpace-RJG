@page "/Evaluators"
@using HackerSpace.Data.DataServices
@rendermode InteractiveServer

@attribute [Authorize(Roles = "Admin")]
@inject EvaluatorsDataService dataService
@inject NavigationManager Navigation

<h3>Evaluators Page</h3>

@if(evaluators == null)
{
    <p>Loading...</p>
}
else
{
    foreach(var evaluator in evaluators)
    {
        <p>@evaluator.ApplicationUserId - @evaluator.BadgeId</p>
    }
    <button type="button" class="btn btn-primary" @onclick="OnAddClick">Add</button>
}

@code {
    private List<Evaluator>? evaluators = null;

    protected async override Task OnInitializedAsync()
    {
        evaluators = await dataService.GetAllAsync();
    }
    private void OnAddClick(MouseEventArgs e)
    {
        Navigation.NavigateTo("evaluatoredit");
    }
}
