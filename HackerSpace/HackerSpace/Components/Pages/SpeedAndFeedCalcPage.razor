@page "/SpeedFeedCalc"
@using System.ComponentModel.DataAnnotations
@using HackerSpace.Data.Models
@rendermode InteractiveServer

<h3>Speed Feed Calculator</h3>

<div class="mb-3 row">
    <label for="rpm" class="col-form-label">RPM</label>
    <InputNumber id="rpm" class="form-control" aria-describedby="revolutions per minute" @bind-Value="speedFeedCalc.RPM" />
    <span id="rpmHelpInline" class="form-text">
        Revolutions Per Minute of spindle.
    </span>
</div>

<div class="mb-3 row">
    <label for="diam" class="col-form-label">Tool Diameter</label>
    <InputNumber id="diam" class="form-control" aria-describedby="diameter of toolbit" @bind-Value="speedFeedCalc.Diam" />
    <span id="diamHelpInline" class="form-text">
        Diameter of toolbit note in inches.
    </span>
</div>

<div class="mb-3 row">
    <label for="sfm" class="col-form-label">Surface Feet Per Minute:</label>
    <span id="sfm">@(Math.Round(speedFeedCalc.SFM,2))</span>
</div>

@code {
    private SpeedFeedCalc speedFeedCalc = new SpeedFeedCalc();
}
